# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
LLM_API_BASE=http://localhost:11434

# LangSmith Tracing Configuration
# Enable/disable LangSmith tracing for AI agent execution observability
# Set to "true" to enable tracing, "false" or leave unset to disable
LANGSMITH_ENABLED=false

# LangSmith project name for organizing traces
# Default: Enterprise-AI-TestAutomation
LANGSMITH_PROJECT_NAME=Enterprise-AI-TestAutomation

# LangSmith API key for authentication
# Required when LANGSMITH_ENABLED=true
# WARNING: Never hardcode API keys in source code - use environment variables only
LANGSMITH_API_KEY=your_api_key_here

# LangSmith API endpoint URL
# Default: https://api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
